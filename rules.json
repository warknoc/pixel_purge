[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": [
              "utm_source",
              "utm_medium",
              "utm_campaign",
              "utm_term",
              "utm_content",
              "fbclid",
              "gclid",
              "msclkid",
              "mc_eid",
              "_hsenc",
              "_hsmi",
              "mc_cid"
            ]
          }
        }
      }
    },
    "condition": {
      "resourceTypes": ["main_frame", "sub_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "block"
    },
    "condition": {
      "regexFilter": "^https?://.*(pixel|beacon|analytics|telemetry|trkn|track|pageview).*(\\.(png|gif|jpg|webp)|/1x1|/collect|/tr\\?|/pixel\\?).*",
      "resourceTypes": ["image", "xmlhttprequest", "ping", "other"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": {
      "type": "block"
    },
    "condition": {
      "urlFilter": "||google-analytics.com",
      "resourceTypes": ["script", "image", "xmlhttprequest", "ping"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": {
      "type": "block"
    },
    "condition": {
      "urlFilter": "||connect.facebook.net/*/fbevents.js",
      "resourceTypes": ["script", "xmlhttprequest"]
    }
  }
]
